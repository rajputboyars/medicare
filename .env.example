# --- Core ---
NEXT_PUBLIC_APP_NAME=MediCare Local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (REQUIRED in production; generate with: openssl rand -base64 48) ---
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=72

# --- Database (optional in V1: without it the app runs on the in-memory demo store) ---
MONGODB_URI=mongodb://127.0.0.1:27017/medicare
DATA_SOURCE=mongo            # mock | mongo

# --- Private file storage (prescriptions / reports). Signed URLs expire quickly ---
FILE_SIGNING_SECRET=change-me-too-another-long-random-string
FILE_URL_TTL_SECONDS=300
STORAGE_PROVIDER=local      # local | s3
S3_BUCKET=
S3_REGION=

# --- Payments ---
PAYMENT_PROVIDER=mock       # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Notifications ---
SMS_PROVIDER=console        # console | msg91 | twilio
WHATSAPP_PROVIDER=console   # console | meta-cloud
EMAIL_PROVIDER=console      # console | smtp
PUSH_PROVIDER=console       # console | fcm
MSG91_AUTH_KEY=
SMTP_URL=
FCM_SERVER_KEY=

# --- Support ---
NEXT_PUBLIC_SUPPORT_PHONE=+911800000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=911800000000

# --- Rate limiting (swap in-memory limiter for Redis in multi-instance deployments) ---
REDIS_URL=
